org.eclipse.jdt.ui.text.custom_templates=<?xml version\="1.0" encoding\="UTF-8" standalone\="no"?><templates><template autoinsert\="false" context\="java-statements" deleted\="false" description\="try catch block" enabled\="true" id\="org.eclipse.jdt.ui.templates.try" name\="try_catch">try {\r\n\t${line_selection}${cursor}\r\n} catch (${Exception} ${exception_variable_name}) {\r\n\tSystem.out.println("${primary_type_name}.${enclosing_method}");\r\n\te.printStackTrace();\r\n}\r\n</template><template autoinsert\="false" context\="java-members" deleted\="false" description\="main method" enabled\="true" id\="org.eclipse.jdt.ui.templates.main" name\="main">public static void main(String[] args) {\r\n\r\n\t//${primary_type_name}.java\r\n\t${cursor}\r\n\r\n}</template><template autoinsert\="true" context\="java" deleted\="false" description\="\uC218\uC5C5\uC6A9" enabled\="true" name\="servlet">@WebServlet(value \= "/${name}.do")&\#13;\r\npublic class ${primary_type_name} extends HttpServlet {&\#13;\r\n\t&\#13;\r\n\t@Override&\#13;\r\n\tprotected void doGet(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {&\#13;\r\n\t\t&\#13;\r\n\t\t//${primary_type_name}.java&\#13;\r\n\t\t${cursor}&\#13;\r\n\t\t&\#13;\r\n\t\treq.getRequestDispatcher("/WEB-INF/views/${name}.jsp").forward(req, resp);&\#13;\r\n\t}&\#13;\r\n&\#13;\r\n}</template><template autoinsert\="true" context\="java" deleted\="false" description\="\uC218\uC5C5\uC6A9" enabled\="true" name\="get">@GetMapping(value \= "/${name}.do")&\#13;\r\npublic String ${name}(Model model) {&\#13;\r\n&\#13;\r\n\t${cursor}&\#13;\r\n\t\t&\#13;\r\n\treturn "${name}";&\#13;\r\n}</template><template autoinsert\="true" context\="java" deleted\="false" description\="\uC218\uC5C5\uC6A9" enabled\="true" name\="param">@RequestParam("${name}") ${type} ${name}${cursor}</template></templates>
